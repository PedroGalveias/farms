  "query": "\n            SELECT\n                p.id,\n                p.slug,\n                p.key_de,\n                p.name_en,\n                p.name_fr,\n                p.name_it,\n                p.name_rm,\n                c.slug AS \"group_slug!\"\n            FROM products p\n            JOIN product_categories c ON c.id = p.category_id\n            ORDER BY c.display_order, c.slug, p.slug\n            ",
